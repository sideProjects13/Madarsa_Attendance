<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.App.Card.PureMonochrome"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minHeight="72dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivTeacherProfile"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:srcCompat="@drawable/teacher_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="Teacher Profile Image" />

        <TextView
            android:id="@+id/tvTeacherName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="@style/TextAppearance.App.PureMonochrome.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/ivTeacherProfile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/toggleGroupAttendance"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Mr. Abdullah Ansari" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupAttendance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.App.Button.Toggle"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresent"
                style="@style/Widget.App.Button.Toggle"
                android:layout_width="wrap_content"
                app:cornerRadius="10dp"
                android:layout_height="wrap_content"
                android:minWidth="60dp"
                android:text="P"
                android:textColor="@color/toggle_button_text_color"
                app:backgroundTint="@color/toggle_button_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbsent"
                app:cornerRadius="10dp"
                style="@style/Widget.App.Button.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="60dp"
                android:text="A"
                android:textColor="@color/toggle_button_text_color"
                app:backgroundTint="@color/toggle_button_tint" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>