<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:background="?attr/colorSurface"
    tools:ignore="UnusedAttribute">

    <!-- Row 1: Reg No. and Student Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_dropdown_reg_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="REG0001 - "
            android:layout_marginEnd="4dp"/>
        <TextView
            android:id="@+id/tv_dropdown_student_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Student Name Placeholder"/>
    </LinearLayout>

    <!-- Row 2: Class / Teacher Name -->
    <TextView
        android:id="@+id/tv_dropdown_teacher_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Class: Teacher Name Placeholder"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end"/>

</LinearLayout>