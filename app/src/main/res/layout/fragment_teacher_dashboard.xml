<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="10dp"
    android:background="?android:colorBackground"
    tools:context=".TeacherDashboardFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/main_content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="invisible"
                tools:visibility="visible">

                <!-- Main Stats Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:padding="8dp">

                    <!-- Card 1: Total Students (Primary Color) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/totalStudentsCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardBackgroundColor="?attr/colorPrimary"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/person" />
                            <TextView
                                android:id="@+id/tvTotalStudentsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="@android:color/white"
                                tools:text="45" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Students"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@android:color/white" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: My Classes (White) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/totalClassesCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_manage_teachers"
                                app:tint="?attr/colorPrimary"/>
                            <TextView
                                android:id="@+id/tvTotalClassesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="3" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Classes"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 3: Inactive Students (White) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/inactiveStudentsCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_person_off"
                                app:tint="?attr/colorPrimary"/>
                            <TextView
                                android:id="@+id/tvTotalInactiveStudentsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="2" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inactive Students"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 4: High Absences (Primary Color) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/highAbsenceCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardBackgroundColor="?attr/colorPrimary"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_high_absences"
                                app:tint="@android:color/white"/>
                            <TextView
                                android:id="@+id/tvHighAbsenceStudentsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="@android:color/white"
                                tools:text="1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="High Absences"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@android:color/white" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>


                <!-- Today's Attendance Summary -->
                <TextView
                    style="@style/DashboardSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Today's Attendance (My Classes)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false">

                    <!-- Present -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/present_card_section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tv_present_count"
                                style="@style/DashboardCardValue"
                                android:textColor="@color/status_paid_green"
                                tools:text="40" />
                            <TextView
                                style="@style/DashboardCardTitle"
                                android:text="Present" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Absent -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/absent_card_section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tv_absent_count"
                                style="@style/DashboardCardValue"
                                android:textColor="@color/status_unpaid_red"
                                tools:text="5" />
                            <TextView
                                style="@style/DashboardCardTitle"
                                android:text="Absent" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Not Marked -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/not_marked_card_section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tv_not_marked_count"
                                style="@style/DashboardCardValue"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="0" />
                            <TextView
                                style="@style/DashboardCardTitle"
                                android:text="Not Marked" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Student Distribution Chart -->
                <TextView
                    style="@style/DashboardSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="Students Across My Classes" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_margin="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/bar_chart_class_distribution"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include layout="@layout/placeholder_dashboard" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>