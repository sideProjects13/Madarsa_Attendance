<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    tools:context=".BulkAddStudentsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/bulk_add_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Bulk Add Students"
        app:titleTextColor="?attr/colorOnPrimary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnPrimary" />

    <ProgressBar
        android:id="@+id/progressBarBulkAdd"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp" />

    <TextView
        android:id="@+id/tvBulkAddStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone"
        tools:text="Processing file: Found 50 students. Saving to Firestore..."
        tools:visibility="visible" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        android:text="CSV/Excel Import Instructions:"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="24dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:text="1. Ensure your file is in CSV (Comma Separated Values) format.\n2. The first row must be a header row.\n3. The columns must be in this exact order:\n   Student Name, Parent Name, Parent Mobile Number, Registration Number, Gender, Birth Date (YYYY-MM-DD), Admission Date (YYYY-MM-DD), Monthly Fee (e.g., 500.00), Profile Image URL (Optional)"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:text="Important Notes:"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="24dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:text="- Mobile Number must be 10 digits (e.g., 9876543210).\n- Dates must be YYYY-MM-DD format (e.g., 2023-01-15).\n- Monthly Fee must be a number greater than 0.\n- Blank values will be treated as empty. Profile Image URL is optional."
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadSampleCsv"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:text="Download Sample CSV"
        app:icon="@drawable/ic_download" /> <!-- You'll need ic_download icon -->

</LinearLayout>