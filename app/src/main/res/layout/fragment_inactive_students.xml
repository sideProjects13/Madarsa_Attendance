<?xml version="1.0" encoding="utf-8"?>
<!-- src/main/res/layout/fragment_inactive_students.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".InactiveStudentsFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_inactive_students"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_inactive_student" />

        <ProgressBar
            android:id="@+id/progress_bar_inactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_no_inactive_students"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No inactive students found."
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>