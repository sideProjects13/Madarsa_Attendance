<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Top Geometric Pattern -->
    <ImageView
        android:id="@+id/geometricPatternTop"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_geometric_pattern_bottom"
        android:rotation="180"
        app:tint="?attr/colorPrimary"
        android:alpha="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Geometric Pattern -->
    <ImageView
        android:id="@+id/geometricPatternBottom"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_geometric_pattern_bottom"
        app:tint="?attr/colorPrimary"
        android:alpha="0.1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnimation"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/splash_logo"
            app:lottie_autoPlay="false"
            app:lottie_loop="false" />

        <!-- App Title -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="MADARSA MANAGEMENT"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Efficient. Reliable. Digital."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:letterSpacing="0.05"/>

    </LinearLayout>

    <!-- Creator/Footer Text -->
    <TextView
        android:id="@+id/creatorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Powered by Your Name/Company"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>